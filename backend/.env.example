# Database
DATABASE_URL=postgresql+psycopg://offboarding:offboarding@localhost:5432/offboarding_agent

# Auth
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Token encryption (for integration_connections.encrypted_token, arga_connections.encrypted_api_key)
TOKEN_ENCRYPTION_KEY=change-me-fernet-key-base64-32-bytes

# LLM (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_PROJECT_ID=

# Production OAuth apps (per system) — used for environment=production connections
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Webhook signature secrets (set when registering the webhook in each platform's app settings)
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=

# Real provider API base URLs (production environment)
GITHUB_API_BASE_URL=https://api.github.com
SLACK_API_BASE_URL=https://slack.com/api
NOTION_API_BASE_URL=https://api.notion.com/v1
LINEAR_API_BASE_URL=https://api.linear.app/graphql

# Arga Labs (sandbox provisioning API — base URL only, each org supplies its own key via arga_connections)
ARGA_API_BASE_URL=https://api.argalabs.com

# App
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated additional origins allowed to call the API (CORS only —
# FRONTEND_BASE_URL above is also where OAuth callbacks redirect back to,
# so set that one to whichever frontend you're actually testing through).
EXTRA_CORS_ORIGINS=
APP_BASE_URL=http://localhost:8000
ENVIRONMENT=development
